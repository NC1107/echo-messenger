FROM nginx:alpine
ARG BUILD_ID=unknown
ARG APP_VERSION=dev
LABEL build_id=$BUILD_ID
COPY build/web/ /usr/share/nginx/html/
RUN echo "$APP_VERSION" > /usr/share/nginx/html/version.txt
COPY nginx.conf /etc/nginx/conf.d/default.conf

# nginx:alpine runs the master as root by default; switching to USER nginx
# requires the worker to be able to write its temp/cache dirs and PID file.
# Without these chowns the container fails to start unless the compose
# service overrides with `user: root`. Chowning here makes the image
# self-contained and correct out of the box.
RUN chown -R nginx:nginx \
        /var/cache/nginx \
        /var/log/nginx \
        /usr/share/nginx/html \
 && touch /var/run/nginx.pid \
 && chown nginx:nginx /var/run/nginx.pid

USER nginx
EXPOSE 80

# Hit the silent /healthz path (nginx.conf disables access logging for it)
# so the healthcheck doesn't spam the access log every interval.
#
# Use 127.0.0.1, not `localhost`: busybox wget in the alpine base resolves
# `localhost` to ::1 first, but nginx only binds IPv4 (`listen 80;` in
# nginx.conf with no `[::]:80`).  IPv6 → connection refused → unhealthy →
# Traefik's docker provider silently filters the container out and the
# router never registers, leaving the public site 404 even though the
# container is actually serving fine.  Tracked down on prod 2026-05-08.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://127.0.0.1/healthz || exit 1
